NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Docker Compose uses host port 15432 by default to avoid clashing with a local PostgreSQL install.
DATABASE_URL=postgresql://app:app@localhost:15432/canvas_video
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=canvas-video
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Replace this value locally. Production must use a long, randomly generated secret.
SESSION_SECRET=replace-me-with-at-least-32-characters

IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
AUDIO_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
AUDIO_PROVIDER_API_KEY=
